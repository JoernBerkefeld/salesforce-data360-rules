{
  "name": "salesforce-data360-rules",
  "version": "0.1.0",
  "description": "Data 360 naming rules between data spaces: how DMO, field, data graph and transform names change from one data space to another",
  "keywords": [
    "salesforce",
    "data360",
    "data-cloud",
    "data-space",
    "dmo"
  ],
  "author": {
    "name": "Jörn Berkefeld",
    "email": "joern.berkefeld@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoernBerkefeld/salesforce-data360-rules.git"
  },
  "homepage": "https://github.com/JoernBerkefeld/salesforce-data360-rules#readme",
  "bugs": {
    "url": "https://github.com/JoernBerkefeld/salesforce-data360-rules/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts eslint.config.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/check-temporary.mjs && node --test \"test/*.test.mjs\"",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepare": "husky || true",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "26.6.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "54.7.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
